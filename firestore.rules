rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper to check if user is one of the authorized administrators
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'info@codecastug.com' || 
        request.auth.token.email == 'joelhitech111@gmail.com'
      );
    }

    // Site Assets & Configuration
    // Public needs to read values like the primary logo URL for the UI
    match /site-assets/{assetId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public Content: Logos, Projects, Blog Posts
    match /client-logos/{logoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blog-posts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Lead Generation: Messages & Subscribers
    // Allow anyone to submit a form, but only admins can manage the leads
    match /messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /subscribers/{subscriberId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Site Analytics: anonymous page-view and web-vitals beacons
    // Any visitor's browser can log an event, but only admins can read
    // the collected analytics or manage it.
    match /page-views/{viewId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /web-vitals/{metricId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Global fallback for any other collections
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}