
{
  "entities": {
    "ClientLogo": {
      "title": "Client Logo",
      "description": "A logo of a trusted partner organization",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the client"
        },
        "imageUrl": {
          "type": "string",
          "description": "URL of the logo image"
        },
        "order": {
          "type": "number",
          "description": "Display order"
        }
      },
      "required": ["name", "imageUrl"]
    },
    "Project": {
      "title": "Project",
      "description": "A portfolio project",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "tag": { "type": "string" },
        "imageUrl": { "type": "string" },
        "iconName": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["title", "imageUrl"]
    },
    "BlogPost": {
      "title": "Blog Post",
      "description": "An article for the news and blog section",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "content": { "type": "string" },
        "imageUrl": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "author": { "type": "string" }
      },
      "required": ["title", "category", "content"]
    },
    "Subscriber": {
      "title": "Newsletter Subscriber",
      "description": "A user who signed up for updates via the pop-up",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["email"]
    },
    "SiteAsset": {
      "title": "Site Asset",
      "description": "A global configuration for the site (e.g., logos, hero backgrounds)",
      "type": "object",
      "properties": {
        "key": { "type": "string", "description": "Unique key (e.g., 'main-logo')" },
        "value": { "type": "string", "description": "The URL or value of the asset" },
        "type": { "type": "string", "enum": ["image", "text"] }
      },
      "required": ["key", "value", "type"]
    },
    "Message": {
      "title": "Contact Message",
      "description": "A message from the contact form",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "service": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/client-logos/{logoId}": {
      "schema": "ClientLogo",
      "description": "Collection of partner logos for the home page"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Portfolio projects"
    },
    "/blog-posts/{postId}": {
      "schema": "BlogPost",
      "description": "News and blog articles"
    },
    "/subscribers/{subscriberId}": {
      "schema": "Subscriber",
      "description": "Newsletter leads from the stay connected popup"
    },
    "/site-assets/{assetId}": {
      "schema": "SiteAsset",
      "description": "Global site configurations and image assets"
    },
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "User inquiries from the contact page"
    }
  }
}
